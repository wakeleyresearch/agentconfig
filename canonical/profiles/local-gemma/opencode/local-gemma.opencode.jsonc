          "options": {
            "num_ctx": 32768
          }
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B A4B MoE Instruct (Local)",
          "num_ctx": 32768,
          "options": {
            "num_ctx": 32768
          }
        },
        "functiongemma:270m": {
          "name": "FunctionGemma 270M Tool Router (Local)",
          "num_ctx": 32768,
          "options": {
            "num_ctx": 32768
          }
        },
        "shieldgemma2:4b": {
          "name": "ShieldGemma 2 4B Safety Classifier (Local)",
          "num_ctx": 32768,
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {}
  }
}
