# Decrypted / private key artifacts (NEVER commit plaintext secrets)
*.dec.*
*.dec
.age/
*.age
keys.txt
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
agentconfig_signing*
.env
.env.*
!.env.example

# Default-deny inside secrets/ (allow only .sops.yaml, README.md, and *.enc.*)
secrets/*
!secrets/.sops.yaml
!secrets/README.md
!secrets/*.enc.yaml
!secrets/*.enc.yml
!secrets/*.enc.json
!secrets/*.enc.env
!secrets/*.enc.ini

# Native harness auth / credential / history / memory runtime files
auth.json
oauth_creds.json
.credentials.json
antigravity-oauth-token
hosts.yml
history.jsonl
mcp_credentials.json
google_accounts.json
secrets.yaml
providers.json
credentials/
ccd-session-secrets/
plugin-mcp-auth/
keyrings/

# Runtime state, backups, build & temp artifacts
dist/
state/
backups/
*.tmp
*.bak
*.orig
*.swp
*.log
*.bundle
*.tar.gz
*.db*
*.sqlite*

# Python caches & virtual environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# NOTE: Never list `.agents/` in .gitignore; Antigravity 2.0 skips .agents/
# rules/skills if present in .gitignore. Generated workspace `.agents/` paths
# are excluded via `.git/info/exclude` instead.
