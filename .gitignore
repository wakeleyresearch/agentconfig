.pytest_cache/
.mypy_cache/

# NOTE: Never list `.agents/` in .gitignore; Antigravity 2.0 skips .agents/
# rules/skills if present in .gitignore. Generated workspace `.agents/` paths
# are excluded via `.git/info/exclude` instead.
