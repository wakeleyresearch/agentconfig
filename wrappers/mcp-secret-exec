#!/usr/bin/env bash
set -euo pipefail

# mcp-secret-exec — Resolves secret_ref IDs from gnome-keyring (secret-tool or gi.Secret) / sops+age,
# strips ambient environment via env -i whitelist, and optionally wraps with bwrap --unshare-net.

umask 0077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UNSHARE_NET=0
REQUIRE_BWRAP=0
SECRET_SPECS=()

usage() {
  cat <<'EOF' >&2
Usage: mcp-secret-exec [--secret-ref ENV_VAR=REF]... [--unshare-net] [--require-bwrap] [--repo <dir>] -- <cmd> [args...]
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --secret-ref)
      SECRET_SPECS+=("${2:?--secret-ref requires ENV_VAR=REF}")
      shift 2
      ;;
    --unshare-net)
      UNSHARE_NET=1
      shift
      ;;
    --require-bwrap)
      REQUIRE_BWRAP=1
      shift
      ;;
    --repo)
      REPO_ROOT="${2:?--repo requires a directory}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "mcp-secret-exec: unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

CMD=("$@")

resolve_secret() {
  local ref="$1"
  local val=""

  # 1. Try secret-tool CLI if installed.
  if command -v secret-tool >/dev/null 2>&1; then
    if val="$(secret-tool lookup application agentconfig secret_ref "$ref" 2>/dev/null)" && [ -n "$val" ]; then
      printf '%s' "$val"
      return 0
    fi
    if val="$(secret-tool lookup secret_ref "$ref" 2>/dev/null)" && [ -n "$val" ]; then
      printf '%s' "$val"
      return 0
    fi
  fi

  # 2. Try Python GI Secret (gnome-keyring) fallback.
  if command -v python3 >/dev/null 2>&1; then
    if val="$(python3 - "$ref" <<'PY' 2>/dev/null
import sys
ref = sys.argv[1]
try:
    import gi
    gi.require_version("Secret", "1")
    from gi.repository import Secret
    schema = Secret.Schema.new(
        "org.agentconfig.Secret",
        Secret.SchemaFlags.NONE,
        {"application": Secret.SchemaAttributeType.STRING, "secret_ref": Secret.SchemaAttributeType.STRING},
    )
    pw = Secret.password_lookup_sync(schema, {"application": "agentconfig", "secret_ref": ref}, None)
    if pw:
        sys.stdout.write(pw)
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
PY
    )" && [ -n "$val" ]; then
      printf '%s' "$val"
      return 0
    fi
  fi

  # 3. Try sops + age encrypted secrets file fallback.
  local sops_bin=""
  if command -v sops >/dev/null 2>&1; then
    sops_bin="$(command -v sops)"
  elif [ -x "$HOME/.local/bin/sops" ]; then
    sops_bin="$HOME/.local/bin/sops"
  fi
  local enc_file="$REPO_ROOT/secrets/secrets.enc.yaml"
  local sops_cfg="$REPO_ROOT/secrets/.sops.yaml"
  if [ -n "$sops_bin" ] && [ -f "$enc_file" ]; then
    local extract_path
    extract_path="$(python3 -c 'import sys; parts = [p for p in sys.argv[1].split("/") if p]; print("".join(f"[{p!r}]" for p in parts))' "$ref")"
    local sops_args=(-d --extract "$extract_path")
    [ -f "$sops_cfg" ] && sops_args=(--config "$sops_cfg" "${sops_args[@]}")
    if val="$("$sops_bin" "${sops_args[@]}" "$enc_file" 2>/dev/null)" && [ -n "$val" ]; then
      printf '%s' "$val"
      return 0
    fi
  fi

  return 1
}

ENV_PAIRS=(
  "PATH=${PATH:-/usr/local/bin:/usr/bin:/bin}"
  "HOME=$HOME"
  "LANG=${LANG:-C.UTF-8}"
  "LC_ALL=${LC_ALL:-C.UTF-8}"
  "TERM=${TERM:-xterm-256color}"
)

if [ -n "${USER:-}" ]; then ENV_PAIRS+=("USER=$USER"); fi
if [ -n "${LOGNAME:-}" ]; then ENV_PAIRS+=("LOGNAME=$LOGNAME"); fi
if [ -n "${TMPDIR:-}" ]; then
  ENV_PAIRS+=("TMPDIR=$TMPDIR" "TEMP=$TMPDIR" "TMP=$TMPDIR")
else
  install -d -m 0700 "$HOME/.local/tmp"
  ENV_PAIRS+=("TMPDIR=$HOME/.local/tmp" "TEMP=$HOME/.local/tmp" "TMP=$HOME/.local/tmp")
fi

for spec in "${SECRET_SPECS[@]}"; do
  if [[ "$spec" != *=* ]]; then
    echo "mcp-secret-exec: invalid --secret-ref '$spec' (expected ENV_VAR=REF)" >&2
    exit 2
  fi
  env_var="${spec%%=*}"
  secret_ref="${spec#*=}"
  if ! secret_val="$(resolve_secret "$secret_ref")"; then
    echo "mcp-secret-exec: unable to resolve secret_ref '$secret_ref' for '$env_var'" >&2
    exit 1
  fi
  ENV_PAIRS+=("${env_var}=${secret_val}")
done

if [ "$UNSHARE_NET" -eq 1 ]; then
  if command -v bwrap >/dev/null 2>&1 && bwrap --ro-bind / / --unshare-net -- true >/dev/null 2>&1; then
    exec env -i "${ENV_PAIRS[@]}" \
      bwrap --unshare-net --die-with-parent --ro-bind / / --dev /dev --proc /proc -- "${CMD[@]}"
  elif [ "$REQUIRE_BWRAP" -eq 1 ]; then
    echo "mcp-secret-exec: --unshare-net requested with --require-bwrap but bwrap userns is unavailable" >&2
    exit 1
  else
    echo "mcp-secret-exec: [warn] bwrap userns unavailable; running with env -i isolation without network namespace" >&2
  fi
fi

exec env -i "${ENV_PAIRS[@]}" "${CMD[@]}"
